{
  "manifest_version": 2,
  "name": "Zen ↔ OpenClaw bridge",
  "version": "0.4.0",
  "description": "Observe allowlisted tabs, let OpenClaw act on them and chat with it through a bridge you control.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-openclaw-bridge@chatondearu.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "notifications",
    "*://*.slack.com/*",
    "https://mail.google.com/*",
    "https://calendar.google.com/*",
    "https://github.com/*",
    "https://linear.app/*",
    "https://claude.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "defaults.js",
      "watch-match.js",
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "optional_permissions": [
    "*://*/*"
  ],
  "browser_action": {
    "default_title": "Chat with OpenClaw",
    "default_popup": "chat.html"
  }
}
